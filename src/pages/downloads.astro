---
import BaseLayout from "../layouts/BaseLayout.astro";
import DownloadsCard from "../components/downloads/DownloadsCard.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

import technicImage from "../assets/downloads/technic.png";
import curseforgeImage from "../assets/downloads/curseforge.png";
import zipImage from "../assets/downloads/zip.png";
import prismImage from "../assets/downloads/prism.png";
import serverImage from "../assets/downloads/server.png";
import amethystImage from "../assets/downloads/amethyst.jpg";
import config from "../config";
import versions from "../../public/versions.json";
import type { VersionEntry } from "../types";

const latestVersion = versions[config.latestVersion] as VersionEntry;
---

<BaseLayout title="Downloads">
  <section class="container mx-auto px-3 sm:px-4 py-6 sm:py-9">
    <div class="text-center mb-6 sm:mb-7">
      <h1 class="text-2xl sm:text-4xl font-bold">
        Download <span class="text-custom-blue font-audiowide">GregTech: New Horizons</span>
      </h1>
      <p class="text-gray-300 text-base sm:text-lg mt-1.5">
        Available for many platforms and launchers. Pick your distribution below.
      </p>
    </div>

    <h2 class="text-center text-xl sm:text-2xl font-semibold mb-3">Direct ZIP Downloads</h2>
    <div class="grid gap-3 sm:gap-4 md:grid-cols-3 mb-7">
      <DownloadsCard
        title="Prism ZIPs"
        links={[
          {
            label: `Latest (${String(config.latestVersion)}) for Java 17-${latestVersion.maxJavaVersion}`,
            href: latestVersion.mmc?.java17_2XUrl!,
            icon: "material-symbols:download-rounded",
            external: true,
            bold: true,
          },
          {
            label: `Latest (${String(config.latestVersion)}) for Java 8`,
            href: latestVersion.mmc?.java8Url!,
            icon: "material-symbols:download-rounded",
            external: true,
          },
          {
            label: "Version history",
            href: "/version-history",
            icon: "mdi:open-in-new",
          },
        ]}
        note="Recommended option"
        noteIcon="mdi:check-circle"
        noteColorClass="text-green-400"
        variant="highlight"
        accentColor="#05df72"
      >
        <div slot="image">
          <Image
            src={prismImage}
            alt="MultiMC/Prism screenshot"
            class="w-full h-full object-cover object-left-top block"
            loading="eager"
          />
        </div>
      </DownloadsCard>

      <DownloadsCard
        title="Server ZIPs"
        links={[
          {
            label: `Latest (${String(config.latestVersion)}) for Java 17-${latestVersion.maxJavaVersion}`,
            href: latestVersion.server?.java17_2XUrl!,
            icon: "material-symbols:download-rounded",
            external: true,
            bold: true,
          },
          {
            label: `Latest (${String(config.latestVersion)}) for Java 8`,
            href: latestVersion.server?.java8Url!,
            icon: "material-symbols:download-rounded",
            external: true,
          },
          {
            label: "Version history",
            href: "/version-history",
            icon: "mdi:open-in-new",
          },
        ]}
        note="Recommended option"
        noteIcon="mdi:check-circle"
        noteColorClass="text-green-400"
        variant="highlight"
        accentColor="#05df72"
      >
        <div slot="image">
          <Image
            src={serverImage}
            alt="Server screenshot"
            class="w-full h-full object-cover object-left-top block"
            loading="eager"
          />
        </div>
      </DownloadsCard>

      <DownloadsCard
        title="Vanilla Launcher ZIP"
        links={[
          {
            label: `Latest (${String(config.latestVersion)}) for Java 8`,
            href: latestVersion.client?.java8Url!,
            icon: "material-symbols:download-rounded",
            external: true,
          },
          {
            label: "Version history",
            href: "/version-history",
            icon: "mdi:open-in-new",
          },
        ]}
        note="Provided for advanced users."
        noteIcon="mdi:alert-circle-outline"
        noteColorClass="text-amber-300"
        variant="solid"
      >
        <div slot="image">
          <Image
            src={zipImage}
            alt="Client screenshot"
            class="w-full h-full object-cover object-left-top block"
            loading="eager"
          />
        </div>
      </DownloadsCard>
    </div>

    <h2 id="launcher-downloads" class="text-center text-xl sm:text-2xl font-semibold mb-3">Launcher Downloads</h2>
    <div class="grid gap-3 sm:gap-4 md:grid-cols-3">
      <DownloadsCard
        title="CurseForge"
        links={[
          {
            label: "Download launcher",
            href: config.curseforgeLauncherUrl,
            icon: "material-symbols:download-rounded",
            external: true,
          },
          { label: "Modpack page", href: config.curseforgeUrl, icon: "mdi:open-in-new", external: true },
        ]}
        variant="solid"
      >
        <div slot="image">
          <Image
            src={curseforgeImage}
            alt="CurseForge screenshot"
            class="w-full h-full object-cover object-left-top block"
            loading="eager"
          />
        </div>
      </DownloadsCard>

      <DownloadsCard
        title="Technic Launcher"
        links={[
          {
            label: "Download launcher",
            href: config.technicLauncherUrl,
            icon: "material-symbols:download-rounded",
            external: true,
          },
          { label: "Modpack page", href: config.technicUrl, icon: "mdi:open-in-new", external: true },
        ]}
        variant="solid"
      >
        <div slot="image">
          <Image
            src={technicImage}
            alt="Technic Launcher screenshot"
            class="w-full h-full object-cover object-left-top block"
            loading="eager"
          />
        </div>
      </DownloadsCard>

      <DownloadsCard
        title="GTNH Mobile"
        links={[
          {
            label: `Latest (${String(config.latestVersion)}) for Mobile`,
            href: latestVersion.mobileUrl!,
            icon: "material-symbols:download-rounded",
            external: true,
            bold: true,
          },
          {
            label: "Version history",
            href: "/version-history",
            icon: "mdi:open-in-new",
          },
          {
            label: "Installation guide",
            href: config.mobileInstallGuideUrl,
            icon: "mdi:open-in-new",
            external: true,
          },
        ]}
        note="Requires Android 10+ and Amethyst Launcher"
        noteIcon="mdi:alert-circle-outline"
        noteColorClass="text-amber-300"
        variant="solid"
      >
        <div slot="image">
          <Image
            src={amethystImage}
            alt="Amethyst Launcher screenshot"
            class="w-full h-full object-cover object-left-top block"
            loading="eager"
          />
        </div>
      </DownloadsCard>

      <aside class="grid items-start gap-3 sm:gap-4 rounded-xl p-3 sm:p-4 bg-[#1a1f26] border border-gray-700" aria-labelledby="downloads-help">
        <div class="flex items-center gap-2">
          <div class="flex items-center justify-center w-9 h-9 rounded-lg bg-[#2a3342]">
            <Icon name="mdi:headset" class="w-5 h-5 text-custom-blue" />
          </div>
          <h3 id="downloads-help" class="text-lg sm:text-xl font-semibold">Need help?</h3>
        </div>

        <p class="text-gray-300 text-sm sm:text-base">
          You can check our wiki for advice on{" "}
          <a
            href={config.installGuideUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-custom-blue hover:underline"
          >
            installing and migrating
          </a>.
        </p>

        <p class="text-gray-300 text-sm sm:text-base">
          Generic instructions didn't help? Join our Discord and ask for help there!
        </p>

        <a
          href={config.discordUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="self-center justify-self-center inline-flex gap-1 sm:gap-1.5 items-center justify-center whitespace-nowrap bg-[#5864f2] hover:bg-[#587cf2] text-white px-2 sm:px-4 py-1.5 sm:py-2 rounded-lg text-base sm:text-lg md:text-xl transition-colors duration-200"
        >
          <Icon name="ic:baseline-discord" class="w-6 sm:w-7 h-6 sm:h-7" />
          Join Discord
        </a>
      </aside>

      <aside class="grid items-start gap-3 sm:gap-4 rounded-xl p-3 sm:p-4 bg-[#1a1f26] border border-gray-700" aria-labelledby="downloads-server-providers">
        <div class="flex items-center gap-2">
          <div class="flex items-center justify-center w-9 h-9 rounded-lg bg-[#2a3342]">
            <Icon name="mdi:server" class="w-5 h-5 text-custom-blue" />
          </div>
          <h3 id="downloads-server-providers" class="text-lg sm:text-xl font-semibold">Looking for a server host?</h3>
        </div>

        <p class="text-gray-300 text-sm sm:text-base">
          We work with hosting providers who offer servers tailored to GT:NH. Click the button below for more information.
        </p>

        <a
          href="/server-providers"
          class="self-center justify-self-center inline-flex gap-1 sm:gap-1.5 items-center justify-center whitespace-nowrap bg-[#557dde] hover:bg-[#558ede] text-white px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg text-base sm:text-lg md:text-xl transition-colors duration-200"
        >
          <Icon name="mdi:server" class="w-6 sm:w-7 h-6 sm:h-7" />
          Server providers
        </a>
      </aside>
    </div>
  </section>
</BaseLayout>
